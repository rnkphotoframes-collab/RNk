# GEMINI_API_KEY: Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# SUPABASE CREDENTIALS (Optional for managed Supabase deployment)
# If provided, the server and client will sync directly to your Supabase PostgreSQL instance.
# If omitted, RNK Photo Frames runs seamlessly on the included persistent database engine.
